{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ain-seen-api",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "GameRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "GameRoom"
      ]
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ain-seen",
      "migrations_dir": "migrations",
      "database_id": "f6f5381f-80e6-4aca-9d93-903bc08ab279"
    }
  ],
  "ratelimits": [
    {
      "name": "CREATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ],
  "vars": {
    "ALLOWED_ORIGINS": "https://marwanywr3-lab.github.io,https://ain-seen.marwanbarbood.com"
  },
  "account_id": "cce61ab85b01cefa97c4def39e73c5ff"
}
